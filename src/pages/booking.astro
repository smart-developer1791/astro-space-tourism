---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Book Your Flight | AstroNova" description="Secure your seat to the stars.">
  <div class="pt-32 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto min-h-screen flex flex-col md:flex-row gap-12 items-start">
    
    <!-- Info Section -->
    <div class="w-full md:w-5/12 sticky top-32">
      <h1 class="text-5xl font-bold text-white mb-6">Ready for <span class="text-gradient">Liftoff?</span></h1>
      <p class="text-lg text-gray-400 mb-8">
        Booking a flight with AstroNova is the first step towards the most profound experience of your life. Fill out the application, and our flight concierges will contact you within 24 hours.
      </p>

      <div class="space-y-6">
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-full bg-neon-blue/20 flex items-center justify-center shrink-0 border border-neon-blue/30 text-neon-blue font-bold">1</div>
          <div>
            <h3 class="text-white font-semibold mb-1">Submit Application</h3>
            <p class="text-sm text-gray-400">Tell us where you want to go and your preferred timeline.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center shrink-0 border border-white/10 text-gray-400 font-bold">2</div>
          <div>
            <h3 class="text-white font-semibold mb-1">Medical Screening</h3>
            <p class="text-sm text-gray-400">A quick, comprehensive health check at our terrestrial facilities.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center shrink-0 border border-white/10 text-gray-400 font-bold">3</div>
          <div>
            <h3 class="text-white font-semibold mb-1">Pre-flight Training</h3>
            <p class="text-sm text-gray-400">3 days of zero-G familiarization and safety protocols.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Booking Form -->
    <div class="w-full md:w-7/12 glass p-8 md:p-12 rounded-3xl border border-white/10 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-neon-purple/10 blur-[80px] rounded-full pointer-events-none -translate-y-1/2 translate-x-1/2"></div>
      
      <form class="relative z-10 space-y-6" id="booking-form" onsubmit="event.preventDefault();">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="firstName" class="block text-sm font-medium text-gray-300">First Name</label>
            <input type="text" id="firstName" class="w-full bg-space-900/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors" placeholder="John" required />
          </div>
          <div class="space-y-2">
            <label for="lastName" class="block text-sm font-medium text-gray-300">Last Name</label>
            <input type="text" id="lastName" class="w-full bg-space-900/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors" placeholder="Doe" required />
          </div>
        </div>

        <div class="space-y-2">
          <label for="email" class="block text-sm font-medium text-gray-300">Email Address</label>
          <input type="email" id="email" class="w-full bg-space-900/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors" placeholder="john@example.com" required />
        </div>

        <div class="space-y-2">
          <label for="destination" class="block text-sm font-medium text-gray-300">Select Destination</label>
          <select id="destination" class="w-full bg-space-900/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors appearance-none" required>
            <option value="" disabled selected>Choose your voyage</option>
            <option value="orbital">Aurora Station (Orbital)</option>
            <option value="luna">Luna Base Alpha (Moon)</option>
            <option value="mars">Mars Colony Prime</option>
          </select>
        </div>
        
        <div class="space-y-2">
          <label for="message" class="block text-sm font-medium text-gray-300">Additional Requests (Optional)</label>
          <textarea id="message" rows="4" class="w-full bg-space-900/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors resize-none" placeholder="Any dietary requirements or special accommodations?"></textarea>
        </div>

        <button type="submit" class="w-full py-4 rounded-xl text-white font-medium bg-gradient-to-r from-neon-blue to-neon-purple hover:opacity-90 transition-opacity shadow-[0_0_20px_rgba(0,240,255,0.2)] hover:shadow-[0_0_25px_rgba(176,38,255,0.4)] flex items-center justify-center gap-2 group">
          Submit Application <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 group-hover:translate-x-1 transition-transform"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </form>
      
      <!-- Success Message (Hidden by default) -->
      <div id="success-message" class="hidden absolute inset-0 bg-space-800/95 backdrop-blur-md flex-col items-center justify-center p-8 text-center z-20">
        <div class="w-16 h-16 rounded-full bg-green-500/20 flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        </div>
        <h3 class="text-3xl font-bold text-white mb-2">Application Received!</h3>
        <p class="text-gray-300 mb-8">Our flight concierges will contact you shortly to begin your journey.</p>
        <button id="reset-btn" class="px-6 py-2 border border-white/20 rounded-full text-white hover:bg-white/10 transition-colors">Return</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import confetti from 'canvas-confetti';

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('booking-form');
    const successMsg = document.getElementById('success-message');
    const resetBtn = document.getElementById('reset-btn');

    if (form && successMsg && resetBtn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Trigger confetti
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 },
          colors: ['#00f0ff', '#b026ff', '#ffffff']
        });

        // Show success
        successMsg.classList.remove('hidden');
        successMsg.classList.add('flex');
      });

      resetBtn.addEventListener('click', () => {
        successMsg.classList.add('hidden');
        successMsg.classList.remove('flex');
        (form as HTMLFormElement).reset();
      });
    }
  });
</script>
