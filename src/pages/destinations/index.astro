---
import Layout from '../../layouts/Layout.astro';
import { destinations } from '../../data/destinations';
---

<Layout title="Destinations | AstroNova" description="Discover our extraordinary space destinations.">
  <div class="pt-32 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto min-h-screen">
    <div class="mb-16 text-center max-w-3xl mx-auto">
      <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">Choose Your <span class="text-gradient">Horizon</span></h1>
      <p class="text-xl text-gray-400">From low earth orbit to the red sands of Mars, our destinations offer unparalleled luxury and adventure.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 dest-grid">
      {destinations.map((dest, index) => (
        <a href={`/destinations/${dest.id}`} class="group glass rounded-3xl overflow-hidden flex flex-col hover:border-neon-blue/50 transition-colors duration-300 dest-card" style={`--delay: ${index * 0.1}s`}>
          <div class="relative h-64 overflow-hidden">
            <img 
              src={dest.image} 
              alt={dest.name} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              style={`view-transition-name: planet-${dest.id}`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-space-800 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end">
              <span class={`px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r ${dest.color} text-white`}>
                {dest.travelTime}
              </span>
              <span class="text-white font-medium drop-shadow-md">{dest.price}</span>
            </div>
          </div>
          
          <div class="p-6 flex-grow flex flex-col">
            <h2 class="text-2xl font-bold text-white mb-2" style={`view-transition-name: title-${dest.id}`}>{dest.name}</h2>
            <p class="text-neon-blue text-sm mb-4">{dest.tagline}</p>
            <p class="text-gray-400 text-sm mb-6 flex-grow">{dest.description}</p>
            
            <div class="flex items-center text-white text-sm font-medium mt-auto group-hover:text-neon-blue transition-colors">
              View Itinerary <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  /* Removed CSS animation to prevent View Transition API conflicts */
</style>
