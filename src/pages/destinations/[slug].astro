---
import Layout from '../../layouts/Layout.astro';
import { destinations } from '../../data/destinations';
import { ArrowLeft, CheckCircle2, Clock } from '@lucide/astro';

export function getStaticPaths() {
  return destinations.map((dest) => ({
    params: { slug: dest.id },
    props: { dest },
  }));
}

const { dest } = Astro.props;
---

<Layout title={`${dest.name} | AstroNova`} description={dest.description}>
  <div class="min-h-screen pb-24">
    <!-- Hero Image Banner -->
    <div class="relative h-[60vh] w-full">
      <img 
        src={dest.image} 
        alt={dest.name} 
        class="w-full h-full object-cover"
        style={`view-transition-name: planet-${dest.id}`}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-space-900 via-space-900/60 to-transparent"></div>
      
      <div class="absolute bottom-0 left-0 w-full p-8 max-w-7xl mx-auto right-0 flex flex-col justify-end h-full">
        <a href="/destinations" class="inline-flex items-center gap-2 text-gray-300 hover:text-white mb-6 w-fit transition-colors">
          <ArrowLeft class="w-5 h-5" /> Back to Destinations
        </a>
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-4" style={`view-transition-name: title-${dest.id}`}>
          {dest.name}
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 max-w-2xl">{dest.tagline}</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-12">
          <section>
            <h2 class="text-3xl font-bold text-white mb-6">About the Journey</h2>
            <p class="text-gray-300 text-lg leading-relaxed">{dest.description}</p>
          </section>

          <section>
            <h2 class="text-3xl font-bold text-white mb-6">Highlights</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {dest.highlights.map(highlight => (
                <div class="glass p-4 rounded-2xl flex items-start gap-3">
                  <CheckCircle2 class="w-6 h-6 text-neon-blue shrink-0" />
                  <span class="text-gray-300">{highlight}</span>
                </div>
              ))}
            </div>
          </section>
        </div>

        <!-- Sidebar / Booking Card -->
        <div class="lg:col-span-1">
          <div class="glass p-8 rounded-3xl sticky top-28">
            <h3 class="text-2xl font-bold text-white mb-6">Trip Details</h3>
            
            <div class="space-y-6 mb-8">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center">
                  <Clock class="w-6 h-6 text-neon-purple" />
                </div>
                <div>
                  <p class="text-sm text-gray-400">Duration</p>
                  <p class="text-lg font-semibold text-white">{dest.travelTime} (Transit)</p>
                </div>
              </div>
              
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-neon-blue"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <p class="text-sm text-gray-400">Distance from Earth</p>
                  <p class="text-lg font-semibold text-white">{dest.distance}</p>
                </div>
              </div>
            </div>

            <div class="pt-6 border-t border-white/10 mb-8">
              <p class="text-sm text-gray-400 mb-1">Starting from</p>
              <p class="text-4xl font-bold text-white">{dest.price}</p>
            </div>

            <a href="/booking" class="block w-full py-4 rounded-full text-center text-white font-medium bg-gradient-to-r from-neon-blue to-neon-purple hover:opacity-90 transition-opacity">
              Reserve Your Seat
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
