---
import Layout from '../layouts/Layout.astro';
import { destinations } from '../data/destinations';
import { Star, ArrowRight } from '@lucide/astro';
import { images } from '../data/images';
---

<Layout title="Journey Beyond">
	<!-- Hero Section -->
	<section class="relative h-screen flex items-center justify-center overflow-hidden">
		<!-- Background Image & Overlay -->
		<div class="absolute inset-0 z-0">
			<img 
				src={images.heroBg}
				alt="Space Background" 
				class="w-full h-full object-cover object-center opacity-40 scale-105"
				id="hero-bg"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-space-900/50 via-space-900/80 to-space-900"></div>
		</div>

		<div class="relative z-10 text-center px-4 max-w-5xl mx-auto mt-20">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/5 backdrop-blur-md mb-8 animate-fade-in-up">
				<Star class="w-4 h-4 text-neon-blue" />
				<span class="text-sm font-medium text-gray-300">The premier space tourism agency</span>
			</div>
			
			<h1 class="text-6xl md:text-8xl font-bold mb-6 tracking-tight leading-tight">
				<span class="block text-white" id="hero-title-1">Journey Beyond</span>
				<span class="block text-gradient" id="hero-title-2">The Stars</span>
			</h1>
			
			<p class="text-lg md:text-2xl text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed" id="hero-desc">
				Experience the ultimate luxury in commercial space travel. From orbital stations to lunar resorts, your next great adventure awaits.
			</p>
			
			<div class="flex flex-col sm:flex-row gap-4 justify-center" id="hero-cta">
				<a href="/destinations" class="px-8 py-4 rounded-full text-white font-medium bg-gradient-to-r from-neon-blue to-neon-purple hover:opacity-90 transition-opacity shadow-[0_0_20px_rgba(0,240,255,0.4)] text-lg">
					Explore Destinations
				</a>
				<a href="/booking" class="px-8 py-4 rounded-full text-white font-medium bg-white/10 hover:bg-white/20 border border-white/10 backdrop-blur-md transition-colors text-lg flex items-center justify-center gap-2">
					Book Now <ArrowRight class="w-5 h-5" />
				</a>
			</div>
		</div>

		<!-- Scroll Indicator -->
		<div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
			<div class="w-[30px] h-[50px] rounded-full border-2 border-white/20 flex justify-center p-2">
				<div class="w-1 h-3 bg-white/50 rounded-full animate-scroll"></div>
			</div>
		</div>
	</section>

	<!-- Featured Destinations Section -->
	<section class="py-24 relative z-10 bg-space-900">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between items-end mb-16">
				<div>
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Featured Voyages</h2>
					<p class="text-gray-400 text-lg">Choose your next extraordinary destination.</p>
				</div>
				<a href="/destinations" class="hidden md:flex items-center gap-2 text-neon-blue hover:text-neon-purple transition-colors font-medium">
					View all <ArrowRight class="w-4 h-4" />
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{destinations.map((dest) => (
					<a href={`/destinations/${dest.id}`} class="group relative rounded-3xl overflow-hidden aspect-[3/4] block card-hover">
						<img 
							src={dest.image} 
							alt={dest.name} 
							class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
							style={`view-transition-name: planet-${dest.id}`}
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-space-900 via-space-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
						
						<div class="absolute inset-0 p-8 flex flex-col justify-end">
							<div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
								<span class={`inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3 bg-gradient-to-r ${dest.color} text-white`}>
									{dest.travelTime}
								</span>
								<h3 class="text-3xl font-bold text-white mb-2">{dest.name}</h3>
								<p class="text-gray-300 text-sm mb-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100 line-clamp-2">
									{dest.description}
								</p>
								<div class="flex items-center justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-200">
									<span class="text-white font-medium">{dest.price}</span>
									<span class="w-10 h-10 rounded-full bg-white/20 backdrop-blur flex items-center justify-center">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
									</span>
								</div>
							</div>
						</div>
					</a>
				))}
			</div>
			
			<div class="mt-8 text-center md:hidden">
				<a href="/destinations" class="inline-flex items-center gap-2 text-neon-blue font-medium">
					View all destinations <ArrowRight class="w-4 h-4" />
				</a>
			</div>
		</div>
	</section>
	
	<!-- Stats / Info Section -->
	<section class="py-24 relative overflow-hidden border-t border-white/5">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="glass rounded-3xl p-8 md:p-16 relative overflow-hidden">
				<div class="absolute top-0 right-0 w-[500px] h-[500px] bg-neon-blue/10 blur-[100px] rounded-full pointer-events-none -translate-y-1/2 translate-x-1/3"></div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center relative z-10">
					<div>
						<h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Pioneering the Next Frontier</h2>
						<p class="text-gray-400 mb-8 leading-relaxed">
							With over a decade of uncrewed missions and five years of perfect safety records in commercial flight, AstroNova sets the gold standard for interplanetary travel. Our fleet is equipped with state-of-the-art life support and luxury amenities.
						</p>
						<ul class="space-y-4">
							<li class="flex items-start gap-3">
								<div class="mt-1 w-6 h-6 rounded-full bg-neon-blue/20 flex items-center justify-center shrink-0">
									<div class="w-2 h-2 rounded-full bg-neon-blue"></div>
								</div>
								<span class="text-gray-300">0% Incident Rate across all civilian flights</span>
							</li>
							<li class="flex items-start gap-3">
								<div class="mt-1 w-6 h-6 rounded-full bg-neon-purple/20 flex items-center justify-center shrink-0">
									<div class="w-2 h-2 rounded-full bg-neon-purple"></div>
								</div>
								<span class="text-gray-300">Michelin-star equivalent dining in zero gravity</span>
							</li>
							<li class="flex items-start gap-3">
								<div class="mt-1 w-6 h-6 rounded-full bg-white/20 flex items-center justify-center shrink-0">
									<div class="w-2 h-2 rounded-full bg-white"></div>
								</div>
								<span class="text-gray-300">Comprehensive pre-flight physiological conditioning</span>
							</li>
						</ul>
					</div>
					
					<div class="grid grid-cols-2 gap-6">
						<div class="bg-space-900/50 rounded-2xl p-6 border border-white/5 text-center">
							<div class="text-4xl font-bold text-gradient mb-2">150+</div>
							<div class="text-sm text-gray-400">Successful Flights</div>
						</div>
						<div class="bg-space-900/50 rounded-2xl p-6 border border-white/5 text-center translate-y-6">
							<div class="text-4xl font-bold text-gradient mb-2">1,200</div>
							<div class="text-sm text-gray-400">Happy Astronauts</div>
						</div>
						<div class="bg-space-900/50 rounded-2xl p-6 border border-white/5 text-center">
							<div class="text-4xl font-bold text-gradient mb-2">3</div>
							<div class="text-sm text-gray-400">Active Destinations</div>
						</div>
						<div class="bg-space-900/50 rounded-2xl p-6 border border-white/5 text-center translate-y-6">
							<div class="text-4xl font-bold text-gradient mb-2">100%</div>
							<div class="text-sm text-gray-400">Carbon Neutral</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	@keyframes scroll {
		0% { transform: translateY(0); opacity: 1; }
		100% { transform: translateY(15px); opacity: 0; }
	}
	.animate-scroll {
		animation: scroll 2s infinite;
	}
	
	.animate-fade-in-up {
		animation: fadeInUp 1s ease-out forwards;
	}
	
	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// Setup animations when the page loads or transitions
	document.addEventListener('astro:page-load', () => {
		// Hero Animations
		const heroBg = document.getElementById('hero-bg');
		if (heroBg) {
			// Initial fade up
			gsap.fromTo(['#hero-title-1', '#hero-title-2', '#hero-desc', '#hero-cta'], 
				{ y: 50, opacity: 0 }, 
				{ y: 0, opacity: 1, duration: 1, stagger: 0.2, ease: "power3.out", delay: 0.2 }
			);

			// Parallax scroll on hero
			gsap.to(heroBg, {
				yPercent: 30,
				ease: "none",
				scrollTrigger: {
					trigger: "section",
					start: "top top",
					end: "bottom top",
					scrub: true
				}
			});
		}

		// Reveal cards on scroll
		const cards = document.querySelectorAll('.card-hover');
		if (cards.length > 0) {
			gsap.fromTo(cards, 
				{ y: 100, opacity: 0 },
				{
					y: 0, 
					opacity: 1, 
					duration: 0.8, 
					stagger: 0.2,
					ease: "power2.out",
					scrollTrigger: {
						trigger: cards[0],
						start: "top 85%",
					}
				}
			);
		}
	});
</script>
